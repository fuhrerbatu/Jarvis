<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.3"
            android:text="J.A.R.V.I.S."
            android:textColor="@color/jarvis_accent"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="Kurulum"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/stepApiKey"
            style="@style/TextAppearance.Material3.TitleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1. Yapay zekâ ve API anahtarı" />

        <RadioGroup
            android:id="@+id/providerGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/providerGemini"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gemini (ücretsiz)" />

            <RadioButton
                android:id="@+id/providerClaude"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Claude (ücretli)" />
        </RadioGroup>

        <TextView
            android:id="@+id/providerNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="API anahtarı"
            app:endIconMode="password_toggle"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/apiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="Model">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/model"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textNoSuggestions"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/saveKey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kaydet" />

            <Button
                android:id="@+id/getKey"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Anahtar al" />
        </LinearLayout>

        <TextView
            android:id="@+id/stepMic"
            style="@style/TextAppearance.Material3.TitleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="2. Mikrofon ve bildirim izni" />

        <Button
            android:id="@+id/grantMic"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="İzin ver" />

        <TextView
            android:id="@+id/stepAccessibility"
            style="@style/TextAppearance.Material3.TitleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="3. Erişilebilirlik servisi" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jarvis'in ekranı okuyup senin yerine dokunabilmesi için gerekli. Ayar gri görünüyorsa: Uygulama bilgisi → sağ üst ⋮ → “Kısıtlanmış ayarlara izin ver”."
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/openAccessibility"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ayarları aç" />

            <Button
                android:id="@+id/openAppInfo"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Uygulama bilgisi" />
        </LinearLayout>

        <TextView
            style="@style/TextAppearance.Material3.TitleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Seçenekler" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/wakeSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="“Jarvis” diye seslenince dinle (sürekli mikrofon)" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/ttsSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cevapları sesli oku" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/bubbleSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ekranda Jarvis düğmesini göster" />

        <TextView
            style="@style/TextAppearance.Material3.TitleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Komut dene" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="ör. WhatsApp'a gir ve anneme naber yaz">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/command"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/runCommand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Çalıştır" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
